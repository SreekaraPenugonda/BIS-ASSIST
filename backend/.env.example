# ============================================================
#  BIS AI Standards Assistant - backend environment template
#  Copy this file to `.env` and fill in your values.
# ============================================================

# ---- Application ----
APP_NAME=BIS AI Standards Assistant
ENVIRONMENT=development
API_PREFIX=/api
HOST=0.0.0.0
PORT=8000

# ---- Security ----
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Comma-separated list of allowed origins (frontend dev server).
# Use "*" to allow every deployed frontend / preview URL (recommended for
# Vercel: each redeploy mints a new URL that can never be allow-listed).
CORS_ORIGINS=*

# ---- Database ----
# SQLite (zero-config, demo default):
DATABASE_URL=sqlite:///./bis_assistant.db
# PostgreSQL with pgvector (production):
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/bis_assistant

# ---- Google Gemini AI ----
# Leave empty -> the app runs in a fully-featured SIMULATION mode
# (RAG retrieval, structured answers, sources and scanner still work).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# ---- Rate limiting (per client IP) ----
RATE_LIMIT_CALLS=120
RATE_LIMIT_WINDOW_SECONDS=60

# ---- Uploads ----
MAX_IMAGE_MB=10
MAX_PDF_MB=15